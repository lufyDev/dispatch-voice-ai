# Port the Express + WebSocket server listens on
PORT=3000

# Optional: pin the public hostname used in the TwiML <Stream> URL.
# Leave empty to derive it from the incoming request's Host header (what ngrok sets).
# Example: abcd-1-2-3-4.ngrok-free.app  (hostname only, no scheme, no trailing slash)
PUBLIC_HOST=

# Which pipeline each call runs: 'echo' (M1, no API key needed) or 'transcribe' (M2)
PIPELINE=transcribe

# https://console.deepgram.com — free credit, no card
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ASR latency knobs (see docs/02-asr.md). endpointing drives speech_final, the
# turn signal we actually use. utterance_end_ms has a hard 1000ms floor in
# Deepgram and is too slow to reply on.
DG_ENDPOINTING=300
DG_UTTERANCE_END_MS=1000
DG_SMART_FORMAT=true

# M3 — LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# M3 — TTS (https://elevenlabs.io free tier)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_flash_v2_5

# M4 — turn-taking
VAD=silero                              # silero | energy  (npm run fetch-model)
SILERO_MODEL_PATH=models/silero_vad.onnx
TURN_GRACE_MS=900                        # hold an unfinished-sounding utterance
TURN_MAX_HOLD_MS=4000                    # never hold longer than this in total
TURN_ASR_SETTLE_MS=400                   # wait for the ASR after the VAD goes quiet
